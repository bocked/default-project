# -----------------------------------------------------------------------------
# Iqtibosim client (Next.js) - faqat foydalaniladigan muhit o'zgaruvchilari.
#
# Nusxa olish:  cp .env.example .env
# Ushbu o'zgaruvchilar build vaqtida (next build) qo'llaniladi. Production
# (Cloudflare Pages) uchun ular Pages envoronment'da sozlanadi.
# -----------------------------------------------------------------------------
#
# XAVFSIZLIK: bu to'rtta o'zgaruvchi NEXT_PUBLIC_ prefiksi bilan o'qiladi, ya'ni
# ular brauzerga ochiq burchak ichida joylashadi va hech qanday maxfiy qiymat
# bu yerda bo'lmasligi kerak. JWT, bot token, DB paroli kabi kalitlar FAQAT
# server/.env da saqlanadi. NEXT_PUBLIC_* prefiksli o'zgaruvchi hech qachon
# maxfiy bo'lmaydi — uni shunday deb hisoblang.
#
# Cloudflare Pages da eng xavfsiz yo'l: kalitni `wrangler pages secret put`
# bilan bermasdan, `deploy.yml` dagi `env:` orqali Actions secrets'idan
# (NEXT_PUBLIC_SENTRY_DSN) o'tkazish.

# Backend API asosiy URL' i (trailing slash siz)
NEXT_PUBLIC_SERVER_URL=

# 1/true qilib qo'ysangiz, ishlab chiqish/test rejimi banneri yoqiladi
NEXT_PUBLIC_TEST_MODE=

# Ixtiyoriy Sentry DSN (bo'sh qoldirish mumkin). Ochiq (public) kalit — xato
# hisobotlari uchun, maxfiy ma'lumot uchun emas.
NEXT_PUBLIC_SENTRY_DSN=