# -----------------------------------------------------------------------------
# Iqtibosim client (Next.js) - faqat foydalaniladigan muhit o'zgaruvchilari.
#
# Nusxa olish:  cp .env.example .env
# Ushbu o'zgaruvchilar build vaqtida (next build) qo'llaniladi. Production
# (Cloudflare Pages) uchun ular Pages envoronment'da sozlanadi.
# -----------------------------------------------------------------------------

# Backend API asosiy URL' i (trailing slash siz)
NEXT_PUBLIC_SERVER_URL=

# 1/true qilib qo'ysangiz, ishlab chiqish/test rejimi banneri yoqiladi
NEXT_PUBLIC_TEST_MODE=

# Ixtiyoriy Sentry DSN (bo'sh qoldirish mumkin)
NEXT_PUBLIC_SENTRY_DSN=