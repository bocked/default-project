generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BannedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Legal policy documents (Terms / Privacy / Cookies). A draft becomes the
// live document only after a SUPER_ADMIN approves it; approving bumps the
// public version, which forces users to re-consent on their next login.
enum PolicyType {
  TERMS
  PRIVACY
  COOKIES
}

enum QuizStatus {
  PENDING
  APPROVED
  REJECTED
}

// Kind of transactional email that produced a row in EmailLog. The log powers
// the Super Admin "Pochta Boshqaruvi" dashboard (history + delivery status).
enum EmailType {
  VERIFICATION
  PASSWORD_RESET
  QUOTE_MODERATION
  ANNOUNCEMENT
  TEST
}

enum EmailStatus {
  SUCCESS
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([targetType, targetId])
}

model ContentBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model User {
  id                          String          @id @default(uuid())
  // Nullable for Telegram quick-login accounts that have not completed
  // registration yet (they get an email + passwordHash on upgrade).
  email                       String?         @unique
  passwordHash                String?
  name                        String? // real name (private, admin-only)
  nickname                    String?
  role                        UserRole        @default(USER)
  emailVerified               Boolean         @default(false)
  emailVerifiedAt             DateTime?
  emailVerificationToken      String?         @unique
  emailVerificationExpiresAt  DateTime?
  resetPasswordToken          String?         @unique
  resetPasswordCodeHash       String?
  resetTokenExpiry            DateTime?
  // Telegram phone verification (private, admin-only).
  telegramId                  String?         @unique
  phoneNumber                 String?
  phoneVerified               Boolean         @default(false)
  // Telegram quick-login profile (private, admin-only).
  telegramUsername            String?
  telegramFirstName           String?
  telegramLastName            String?
  // True for accounts created via the one-tap Telegram login that have not
  // completed a full registration (email + password). They may like quotes
  // but cannot post new ones until they upgrade.
  quickLogin                  Boolean         @default(false)
  // Pending Telegram verification session: hashed /start token bound to the
  // chat, and the hashed 6-digit code sent to that chat.
  telegramVerifyToken         String?         @unique
  telegramVerifyExpiresAt     DateTime?
  telegramVerifyChatId        String?
  telegramVerifyCode          String?
  telegramVerifyCodeExpiresAt DateTime?
  // Pending email verification: the 6-digit OTP code (digest) sent alongside
  // the /verify-email link token. Either one verifies.
  emailVerifyCodeHash         String?
  emailVerifyCodeExpiresAt    DateTime?
  // Premium (VIP): isPremium may stay true after premiumExpiresAt passes —
  // gate "active" with premiumExpiresAt at read time, not just isPremium.
  isPremium                   Boolean         @default(false)
  premiumExpiresAt            DateTime?
  // Replaces "yerlikoglon.uz" with the user's own channel/handle on share images.
  customWatermark             String?
  // Manually approved by a SUPER_ADMIN: lets the user post quotes without the
  // email/phone verification step (feature is super-admin-only).
  isSuperApproved             Boolean         @default(false)
  superApprovedAt             DateTime?
  // Terms of Use version this user last accepted. When it differs from the
  // current version the user must re-consent on their next login.
  acceptedTermsVersion        String?
  // Public avatar image URL shown on the profile and on the author's quotes.
  avatarUrl                   String?
  // Rotating refresh token used to mint short-lived access tokens. Only the
  // SHA-256 digest is stored; the raw value lives in an HttpOnly cookie.
  refreshTokenHash            String?         @unique
  refreshTokenExpiresAt       DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  // Moderation controls (admin panel).
  blocked                     Boolean         @default(false)
  blockedAt                   DateTime?
  deletedAt                   DateTime?
  quotes                      Quote[]
  feedback                    Feedback[]
  activities                  UserActivity[]
  likes                       QuoteLike[]
  quizzes                     Quiz[]
  quizResults                 QuizResult[]

  @@index([createdAt])
  @@index([role, createdAt(sort: Desc)])
}

model Category {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  quotes Quote[]

  @@index([name])
}

model Tag {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  quotes Quote[]

  @@index([name])
}

model Quote {
  id                  String      @id @default(uuid())
  text                String
  displayAuthor       String
  anonymous           Boolean     @default(false)
  status              QuoteStatus @default(PENDING)
  rejectionReason     String?
  awaitingRejection   Boolean     @default(false)
  telegramMessageId   Int? // id of the Telegram moderation message
  telegramUrl         String? // optional t.me/<channel>/<id> post embedded on the site
  telegramPostedAt    DateTime? // when the quote was published to the Telegram channel
  customStyles        Json? // VIP-only post card styling (fonts, colors, frame, texture)
  views               Int         @default(0) // public feed views (analytics)
  userId              String
  categoryId          String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category    @relation(fields: [categoryId], references: [id])
  tags                Tag[]
  likes               QuoteLike[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, categoryId])
  @@index([status, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([telegramMessageId])
  @@index([deletedAt, status])
}

model QuoteLike {
  id        String   @id @default(uuid())
  userId    String
  quoteId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, quoteId])
  @@index([quoteId, createdAt(sort: Desc)])
}

// Legal document versions. At most one open "draft" (isApproved=false) per
// type is expected at a time; approving it publishes the content. The public
// pages (/terms, /privacy, /cookies) and the consent modals read the latest
// APPROVED row for each type. `version` follows the "M.m" format.
model SitePolicy {
  id            String     @id @default(uuid())
  type          PolicyType
  version       String
  content       String
  isApproved    Boolean    @default(false)
  // Short human-readable summary of what changed in this version.
  changeSummary String?
  // Free-form reason the approving SUPER_ADMIN left on the document.
  changeReason  String?
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([type, version])
  @@index([type, isApproved])
  @@index([isApproved])
}

// Test/quiz created by any user; like quotes, a new quiz is moderated
// (PENDING) until an admin approves or rejects it.
model Quiz {
  id              String         @id @default(uuid())
  title           String
  description     String?
  status          QuizStatus     @default(PENDING)
  rejectionReason String?
  authorId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  results         QuizResult[]

  @@index([status, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model QuizQuestion {
  id           String    @id @default(uuid())
  quizId       String
  question     String
  // Possible answers; the correct one is `options[correctIndex]`. The index
  // is never exposed while taking the quiz (only after submitting).
  options      String[]
  correctIndex Int
  createdAt    DateTime  @default(now())
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

// Latest attempt of a user on a quiz (one row per quiz per user — retakes
// overwrite). `answers` keeps the chosen option indexes for review.
model QuizResult {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  score     Int
  total     Int
  answers   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  message     String
  // SITE banner only, TELEGRAM broadcast, EMAIL broadcast, or ALL.
  channel     String    @default("ALL")
  // ACTIVE (visible/sent) or ARCHIVED (hidden).
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // COMPLAINT | SUGGESTION | REPORT | OTHER
  category   String   @default("OTHER")
  text       String
  quoteId    String?
  // OPEN | IN_PROGRESS | RESOLVED
  status     String   @default("OPEN")
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model SiteSetting {
  key       String   @id
  value     String
  label     String
  // general | seo
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
}

model SeoRule {
  id          String    @id @default(uuid())
  // home | category:<slug> | tag:<slug> | quote:<id>
  page        String    @unique
  title       String?
  description String?
  keywords    String?
  updatedAt   DateTime  @updatedAt

  @@index([page])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REGISTER | LOGIN | QUOTE_CREATE | QUOTE_LIKE | QUOTE_COMMENT | PROFILE_UPDATE
  action    String
  detail    String?
  targetId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model Backup {
  id          String   @id @default(uuid())
  label       String
  // JSON snapshot of core tables.
  data        String
  size        Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model DailyStat {
  id        String   @id @default(uuid())
  // YYYY-MM-DD (UTC).
  date      String   @unique
  // Unique visitors and total page views aggregated daily.
  visitors  Int      @default(0)
  pageViews Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([date])
}

model TelegramQuickSession {
  id          String    @id @default(uuid())
  // SHA-256 digest of the opaque `quick_<sessionId>` payload.
  tokenHash   String    @unique
  // Telegram chat that completed the /start quick_ link.
  chatId      String?
  // PENDING | COMPLETE | EXPIRED | ERROR
  status      String    @default("PENDING")
  userId      String?
  error       String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}

// Delivery history of every transactional email (OTP verification, password
// reset, moderation notifications, announcements, SMTP test messages). Status
// mirrors what the transport reported; a FAILED row keeps the error for the
// Super Admin email dashboard.
model EmailLog {
  id        String      @id @default(uuid())
  type      EmailType
  to        String
  subject   String
  status    EmailStatus
  messageId String?
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([to, createdAt(sort: Desc)])
}
