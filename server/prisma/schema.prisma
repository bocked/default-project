generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BannedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([targetType, targetId])
}

model ContentBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  passwordHash                String
  name                        String? // real name (private, admin-only)
  nickname                    String?
  role                        UserRole  @default(USER)
  emailVerified               Boolean   @default(false)
  emailVerificationToken      String?   @unique
  emailVerificationExpiresAt  DateTime?
  resetPasswordToken          String?   @unique
  resetPasswordExpiresAt      DateTime?
  // Telegram phone verification (private, admin-only).
  telegramId                  String?   @unique
  phoneNumber                 String?
  phoneVerified               Boolean   @default(false)
  // Pending Telegram verification session: hashed /start token bound to the
  // chat, and the hashed 6-digit code sent to that chat.
  telegramVerifyToken         String?   @unique
  telegramVerifyExpiresAt     DateTime?
  telegramVerifyChatId        String?
  telegramVerifyCode          String?
  telegramVerifyCodeExpiresAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  // Moderation controls (admin panel).
  blocked                     Boolean   @default(false)
  blockedAt                   DateTime?
  deletedAt                   DateTime?
  quotes                      Quote[]

  @@index([createdAt])
  @@index([role, createdAt(sort: Desc)])
}

model Category {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  quotes Quote[]

  @@index([name])
}

model Tag {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  quotes Quote[]

  @@index([name])
}

model Quote {
  id                  String      @id @default(uuid())
  text                String
  displayAuthor       String
  anonymous           Boolean     @default(false)
  status              QuoteStatus @default(PENDING)
  rejectionReason     String?
  awaitingRejection   Boolean     @default(false)
  telegramMessageId   Int? // id of the Telegram moderation message
  telegramUrl         String? // optional t.me/<channel>/<id> post embedded on the site
  userId              String
  categoryId          String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category    @relation(fields: [categoryId], references: [id])
  tags                Tag[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, categoryId])
  @@index([status, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([telegramMessageId])
  @@index([deletedAt, status])
}
