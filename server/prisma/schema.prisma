generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BannedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
