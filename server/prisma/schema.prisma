generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  role         Role         @default(USER)
  displayName  String
  color        String       @default("#3b82f6")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items CanvasItem[]

  @@index([role])
}

model CanvasItem {
  id        String   @id @default(uuid())
  type      String
  content   String
  x         Float
  y         Float
  color     String?
  ipAddress String
  reactions String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([userId])
}

model BannedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
