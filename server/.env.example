# -----------------------------------------------------------------------------
# Iqtibosim backend - faqat foydalaniladigan muhit o'zgaruvchilari kalitlari.
#
# Nusxa olish:  cp .env.example .env
# So'ng .env faylini o'z xavfsiz qiymatlaringiz bilan to'ldiring.
# Production muhitida ADMIN_PASSWORD va JWT_SECRET kuchsiz qiymat bo'lsa
# server ishga tushmaydi (FATAL). Barcha kalitlar server/src/config.ts da o'qiladi.
# -----------------------------------------------------------------------------
#
# PRODUCTION DA MAJBURIY (yo'q bo'lsa server FATAL bilan to'xtaydi — bu ataylab):
#   DATABASE_URL          32+ belgili JWT_SECRET, 12+ belgili ADMIN_PASSWORD,
#                         ADMIN_EMAILS va SUPER_ADMIN_EMAILS (vergul bilan).
#   Tavsiya:  openssl rand -base64 32   (JWT_SECRET uchun)
#             openssl rand -base64 12   (ADMIN_PASSWORD uchun)
# Dev/test rejimida (NODE_ENV != production) bular o'chirilgan bo'lsa ham
# ishlaydi — shuning uchun lokal rivojlanish qiyin emas.

# Asosiy
# DATABASE_URL production'da majburiy. Dev uchun standart:
# DATABASE_URL=postgresql://canvas:canvas@localhost:5432/canvas?schema=public
PORT=
NODE_ENV=
DATABASE_URL=
REDIS_URL=
# Ruxsat etilgan brauzer origin'lar (CORS) — vergul bilan ajratilgan ro'yxat.
# Tavsiya: CORS_ORIGINS="http://localhost:3000,https://*.pages.dev,https://yerlikoglon.uz,https://www.yerlikoglon.uz,https://*.yerlikoglon.uz,https://api.yerlikoglon.uz"
CORS_ORIGINS=
# Teskari proksi (nginx/Cloudflare) orqasidagi ishonchli hop soni — IP bo'yicha
# rate limit va CORS uchun to'g'ri hisoblanishi uchun 1 qo'yiladi.
TRUST_PROXY=
LOG_LEVEL=
LOG_TO_CONSOLE=

# Admin / huquqlar
# ADMIN_PASSWORD kamida 12 belgi bo'lishi shart (production'da FATAL).
ADMIN_PASSWORD=
# ADMIN_EMAILS: ro'yxatdagi pochta bilan ro'yxatdan o'tish/kirishda ADMIN roli
# beriladi. SUPER_ADMIN_EMAILS esa eng kuchli roli beradi. Ikkalasi ham
# production'da majburiy — avval ular kod ichida shaxsiy pochta bilan
# to'ldirilgan edi, bu esa maxfiy ro'yxatni git tarixiga ko'chirgan edi.
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=
# /api/admin/* ga kirish uchun IP ro'yxati (bo'sh qoldirilsa har qanday
# autentifikatsiyalangan admin kirishi mumkin).
ADMIN_IP_WHITELIST=

# Auth
# JWT_SECRET kamida 32 belgi bo'lishi shart (production'da FATAL). Bu kalit
# admin tokenini soxta yozishga imkon beruvchi yagona chegara.
JWT_SECRET=
APP_URL=
CURRENT_TERMS_VERSION=
VERIFICATION_TOKEN_MINUTES=
EMAIL_OTP_MINUTES=
REFRESH_TOKEN_DAYS=

# Email yuborish (SMTP > Resend > offline transcript). SMTP sozlangan bo'lsa,
# sendEmail() SMTP orqali ketadi, aks holda Resend API, bo'lmasa offline log.
# Gmail App Password misolida:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_SANDBOX=
RESEND_SANDBOX_TO=
RESEND_WEBHOOK_SECRET=

# Telegram (moderatsiya boti)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
SITE_URL=

# AI (iqtibos tahlili — OpenAI mos keluvchi chat completions API)
# AI_API_KEY bo'sh bo'lsa tahlil offline (lug'at) rejimda ishlaydi.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Sentry (ixtiyoriy monitoring)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=

# Rasmlar yuklash (WebP-ga aylantiriladi)
# UPLOAD_DIR=            fayllar saqlanadigan katalog (default: <server>/uploads, .gitignore'da)
# UPLOADS_PUBLIC_BASE=   qaytarilgan URL'larga qo'shiladigan ommaviy manzil (default: https://api.yerlikoglon.uz)
# MAX_UPLOAD_BYTES=      har bir fayl uchun bayt cheklovi (default: 5242880 = 5MB)
# MAX_UPLOAD_DIMENSION=  eng katta tomon (px), kattasi kichraytiriladi (default: 1280)

# Test (faqat server/tests uchun)
TEST_DATABASE_URL=