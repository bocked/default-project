# -----------------------------------------------------------------------------
# Iqtibosim backend - faqat foydalaniladigan muhit o'zgaruvchilari kalitlari.
#
# Nusxa olish:  cp .env.example .env
# So'ng .env faylini o'z xavfsiz qiymatlaringiz bilan to'ldiring.
# Production muhitida ADMIN_PASSWORD va JWT_SECRET kuchsiz qiymat bo'lsa
# server ishga tushmaydi (FATAL). Barcha kalitlar server/src/config.ts da o'qiladi.
# -----------------------------------------------------------------------------

# Asosiy
PORT=
NODE_ENV=
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=
TRUST_PROXY=
LOG_LEVEL=
LOG_TO_CONSOLE=

# Admin / huquqlar
ADMIN_PASSWORD=
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=
ADMIN_IP_WHITELIST=

# Auth
JWT_SECRET=
APP_URL=
CURRENT_TERMS_VERSION=
VERIFICATION_TOKEN_MINUTES=
EMAIL_OTP_MINUTES=
REFRESH_TOKEN_DAYS=

# Resend (email yuborish)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_SANDBOX=
RESEND_SANDBOX_TO=
RESEND_WEBHOOK_SECRET=

# Telegram (moderatsiya boti)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
SITE_URL=

# Sentry (ixtiyoriy monitoring)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=

# Test (faqat server/tests uchun)
TEST_DATABASE_URL=