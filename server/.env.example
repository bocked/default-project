# Server environment configuration
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (docker compose or external)
DATABASE_URL="postgresql://canvas:canvas@localhost:5432/canvas?schema=public"

# Redis (optional). If unset the server falls back to an in-memory event bus
# and presence store (single instance only).
REDIS_URL="redis://localhost:6379"

# Comma separated list of allowed browser origins (CORS)
CORS_ORIGINS="http://localhost:3000,https://*.pages.dev"

# Shared secret protecting the /admin endpoints and admin socket auth
ADMIN_PASSWORD="change-me"

# Public base URL of this API server (used to build absolute URLs)
PUBLIC_BASE_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Cloudflare R2 (optional). Without these the server stores uploaded images on
# the local disk (server/uploads) which is fine for development.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="uploads"
R2_PUBLIC_URL="" # e.g. https://pub-xxxx.r2.dev or a custom domain
