# Server environment configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info # pino level: trace|debug|info|warn|error
LOG_TO_CONSOLE=true

# Number of trusted reverse-proxy hops (Render LB / Nginx)
TRUST_PROXY=1

# PostgreSQL connection string (docker compose or external)
DATABASE_URL="postgresql://canvas:canvas@localhost:5432/canvas?schema=public"

# Redis (optional). If unset the server falls back to an in-memory event bus.
REDIS_URL="redis://localhost:6379"

# Comma separated list of allowed browser origins (CORS)
CORS_ORIGINS="http://localhost:3000,https://*.pages.dev,https://yerlikoglon.uz,https://*.yerlikoglon.uz"

# Shared secret protecting the /api/admin endpoints and admin socket auth
ADMIN_PASSWORD="change-me"

# Sentry error monitoring (optional). Leave empty to disable; set a DSN to
# start capturing errors + traces in real time.
SENTRY_DSN=""
# Fraction of requests sampled for performance tracing (0-1, default 0.1)
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ---------------------------------------------------------------------------
# Iqtibosim - auth, email verification and Telegram moderation
# ---------------------------------------------------------------------------

# Secret used to sign auth JWTs. Generate a long random value in production.
JWT_SECRET="change-me"

# Public frontend origin (used to build email verification links).
APP_URL="http://localhost:3000"

# Email verification token + 6-digit OTP lifetime in minutes. The OTP is kept
# short (10 min) so admin-revealed codes stay relevant.
VERIFICATION_TOKEN_MINUTES=15
EMAIL_OTP_MINUTES=10

# Rotating refresh token (HttpOnly cookie) lifetime in days.
REFRESH_TOKEN_DAYS=30

# Resend transactional email API (replaces the legacy SMTP/Brevo paths). Get a
# key at https://resend.com/api-keys. Leave empty to fall back to a console
# logger + in-memory transcript (dev/test mode - no real mail is delivered).
RESEND_API_KEY=""
# Verified sender. yerliki-own domain no-reply@yerlikoglon.uz is used once
# yerlikoglon.uz is Verified in the Resend dashboard (production mode).
EMAIL_FROM="yerlikoglon.uz <no-reply@yerlikoglon.uz>"
# Production mode: the sender domain is verified, so Resend delivers to any
# recipient. RESEND_SANDBOX=0 fully disables the sandbox allow-list.
RESEND_SANDBOX=0
# Signing secret from the Resend webhook endpoint (dashboard -> Webhooks).
# Required by /api/webhooks/resend so delivery events update the email log.
# RESEND_WEBHOOK_SECRET="whsec_..."

# Telegram moderation bot.
# TELEGRAM_BOT_TOKEN and TELEGRAM_ADMIN_CHAT_ID drive outbound bot messages;
# leave empty to run without the bot (webhook still processes updates).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Secret shared with Telegram when registering the webhook. Telegram sends it
# back in the `X-Telegram-Bot-Api-Secret-Token` header on every update.
TELEGRAM_WEBHOOK_SECRET=""

# Public HTTPS URL of the webhook, e.g. https://<backend>/api/telegram/webhook
# Used by `npm run telegram:webhook` to register the bot endpoint.
TELEGRAM_WEBHOOK_URL=""
